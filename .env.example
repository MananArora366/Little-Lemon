# Copy this file to .env and fill in the values
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Production only. Turns on SSL redirect, secure cookies and HSTS.
# Leave False locally: the test runner forces DEBUG=False and would 301 every request.
SECURE_PRODUCTION=False

